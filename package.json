{
  "name": "linguist-agent-dsh",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare:local": "node scripts/prepare.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test:domain": "pnpm --filter @linguist/cat-core typecheck && pnpm --filter @linguist/cat-formats typecheck && pnpm --filter @linguist/cat-store test && pnpm --filter @linguist/cat-tools test && pnpm --filter @linguist/domain-service test",
    "test:required": "node scripts/test-required.mjs",
    "build": "node scripts/build.mjs",
    "pack:plugin": "node scripts/pack.mjs",
    "install:local": "node scripts/install-local.mjs",
    "launch": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "test": "node scripts/test-required.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsdown": "0.22.14",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
