      "scene": "受击被动：低生命时减轻所受伤害，条件随当前生命变化；无额外触发事件。",
      "relatedText": [],
      "source": {
        "text": "生命值低于30%时，受到的伤害降低15%。"
      },
      "candidates": [
        {
          "id": "A",
          "text": "Take 15% less damage while below 30% HP."
        },
        {
          "id": "B",
          "text": "When HP reaches 30%, deal 15% more damage."
        }
      ],
      "judgment": {
        "decision": "keep-A-reject-B",
        "rationale": "A 直接、自然，保留持续条件、严格低于和伤害承受方向；无需补成与原句逐项同序。B 改成精确到达条件和输出增益。"
      },
      "invariants": [
        "低于30%而非等于",
        "所受伤害降低15%"
      ],
      "when": [
        "项目允许 HP 缩写且含义明确"
      ],
      "notWhen": [
        "若项目 required 术语为 Health，则按项目规则调整缩写，不据此推翻整套表达"
      ],
      "ruleRefs": [
        "PJ-02",
        "PJ-04",
        "PJ-09"
      ],
      "origin": "original-model-authored-teaching-example",
