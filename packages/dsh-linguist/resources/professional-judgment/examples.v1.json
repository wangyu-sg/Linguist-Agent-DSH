      "scene": "撤回交易确认框。{seller} 是卖方名，{buyer} 是买方名，{amount} 是货币数量；变量可重排但身份不能互换。",
      "relatedText": [],
      "source": {
        "text": "{seller} 将退还 {amount} 金币给 {buyer}。"
      },
      "candidates": [
        {
          "id": "A",
          "text": "{buyer} will refund {amount} gold to {seller}."
        },
        {
          "id": "B",
          "text": "{seller} will refund {amount} gold to {buyer}."
        },
        {
          "id": "C",
          "text": "{seller} will refund gold to {buyer}."
        }
      ],
      "judgment": {
        "decision": "reject-A-and-C-accept-B",
        "rationale": "A 保留了变量集合却交换主体和受益者；C 丢失数量参数。结构校验与意义核验都必要。"
      },
      "invariants": [
        "付款方向",
        "全部参数身份与数量"
      ],
      "when": [
        "交易规格与参数词典明确这些身份"
      ],
      "notWhen": [
        "变量词典缺失或 seller 实际不是身份时先查证，不能从变量名推断到绝对结论"
      ],
      "ruleRefs": [
        "PJ-02",
