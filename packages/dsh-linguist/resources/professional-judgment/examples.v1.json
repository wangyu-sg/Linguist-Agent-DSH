      "scene": "战斗技能说明。命中但未击败敌人时也会触发；护盾没有伤害效果。",
      "relatedText": [],
      "source": {
        "text": "命中敌人后，获得持续4秒的护盾。"
      },
      "candidates": [
        {
          "id": "A",
          "text": "Defeating an enemy grants a shield for 4 seconds."
        },
        {
          "id": "B",
          "text": "Hitting an enemy grants a shield for 4 seconds."
        }
      ],
      "judgment": {
        "decision": "edit-A-to-B-or-equivalent",
        "rationale": "A 虽流畅且数字完全相同，却把命中条件改为击杀。判断不能只依靠数字与 Tag QA。"
      },
      "invariants": [
        "触发为命中",
        "持续4秒",
        "获得护盾"
      ],
      "when": [
        "技能规格确认 on hit"
      ],
      "notWhen": [
        "若新版明确改成 on kill，旧案例不得用于反对新版"
      ],
      "ruleRefs": [
        "PJ-02",
        "PJ-05",
        "PJ-10"
      ],
