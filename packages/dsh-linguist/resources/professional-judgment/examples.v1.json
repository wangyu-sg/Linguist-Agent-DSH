      "scene": "轻松奇幻游戏的纯外观斗篷；物品规格明确没有属性加成。",
      "relatedText": [],
      "source": {
        "name": "摸鱼披风",
        "description": "披上它，连偷懒都有了仪式感。"
      },
      "candidates": [
        {
          "id": "A",
          "name": "Cloak of Clocking Out",
          "description": "For taking it easy in style."
        },
        {
          "id": "B",
          "name": "Cloak of Clocking Out",
          "description": "Wear it to gain 20% more gold while you nap."
        }
      ],
      "judgment": {
        "decision": "accept-A-reject-B",
        "rationale": "A 用工作语域保持懒散笑点；B 新增金币倍率与挂机奖励，属于机制/属性发明，不是合理创译。"
      },
      "invariants": [
        "纯外观，无奖励加成"
      ],
      "when": [
        "A 适用于允许现代工作类比的喜剧外观文案"
      ],
      "notWhen": [
        "禁用现代工作类比的严肃古典世界不适合 A；B 在本案例任何场景都不能接受"
      ],
