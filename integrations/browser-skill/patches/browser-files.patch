diff --git a/packages/dsh-plugin-browserskill/src/file-tools.ts b/packages/dsh-plugin-browserskill/src/file-tools.ts
--- /dev/null
+++ b/packages/dsh-plugin-browserskill/src/file-tools.ts
@@ -0,0 +1,318 @@
+/** BrowserSkill file transfers through the existing session, runner and queues. */
+
+import { createHash, randomUUID } from "node:crypto";
+import { link, lstat, mkdir, readFile, realpath, rename, rm, stat, writeFile } from "node:fs/promises";
+import { basename, dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { defineTool, type ToolDefinition, type ToolResult, type ToolRunContext } from "@deepseek-ai/dsh-tools";
+import type { ToolDeps } from "./tools";
+import { defaultStartJournalDirectory } from "./start-journal";
+import { SESSION_PARAM, TAB_ID_PARAM, TIMEOUT_MS_PARAM } from "./tool-params";
+
+type TransferStatus = "pending" | "unknown" | "failed" | "downloaded" | "attached";
+interface TransferReceipt {
+  session: string;
+  requestId: string;
+  status: TransferStatus;
+  out?: string;
+  tabId?: number;
+  fileNames?: string[];
+  byteSize?: number;
+  message?: string;
+}
+interface StoredReceipt {
+  action: "download" | "upload";
+  fingerprint: string;
+  value: TransferReceipt;
+}
+
+interface FileToolHelpers {
+  run(exec: ToolRunContext, args: string[], label: string, session: string): Promise<unknown>;
+  commandLine(args: string[]): string;
+  presentTerminalResult(args: never, result: ToolResult): { card: "terminal"; output: string; exitCode: number } | undefined;
+}
+
+const BROWSER_DOWNLOAD_QUEUE = "__browser_skill_global_download__";
+const RESULT_SCHEMA = {
+  type: "object",
+  additionalProperties: false,
+  properties: {
+    session: { type: "string", required: true },
+    requestId: { type: "string", required: true },
+    status: { type: "string", enum: ["pending", "unknown", "failed", "downloaded", "attached"], required: true },
+    out: { type: "string" },
+    tabId: { type: "integer" },
+    fileNames: { type: "array", items: { type: "string" } },
+    byteSize: { type: "integer" },
+    message: { type: "string" },
+  },
+} as const;
+
+function verifyRequestId(requestId: string): void {
+  if (!/^[A-Za-z0-9._-]{1,128}$/.test(requestId)) {
+    throw new Error("requestId must be 1–128 ASCII letters, digits, dot, underscore or hyphen");
+  }
+}
+
+function inside(root: string, path: string): boolean {
+  const suffix = relative(root, path);
+  return suffix === "" || (suffix !== ".." && !suffix.startsWith(`..${sep}`) && !isAbsolute(suffix));
+}
+
+async function transferPath(
+  deps: ToolDeps,
+  exec: ToolRunContext,
+  input: string,
+  kind: "upload" | "download",
+): Promise<string> {
+  if (input.trim() === "") throw new Error("file path must be non-empty");
+  const sessions = deps.ctx.get("sessions") as
+    | { get(id: string): { header: { cwd?: string } } | undefined }
+    | undefined;
+  const workspace = exec.agent?.id === undefined ? undefined : sessions?.get(exec.agent.id)?.header.cwd;
+  if (!isAbsolute(input) && workspace === undefined) {
+    throw new Error("relative file path requires a DSH session working directory");
+  }
+  const roots = await Promise.all(
+    [workspace, deps.config.fileStagingDirectory]
+      .filter((path): path is string => path !== undefined)
+      .map((path) => realpath(path)),
+  );
+  if (roots.length === 0) throw new Error("no allowed browser file directory is configured");
+  const path = resolve(workspace ?? "/", input);
+  if (kind === "upload") {
+    const actual = await realpath(path);
+    if (!roots.some((root) => inside(root, actual))) throw new Error("upload path is outside the workspace and staging directory");
+    if (!(await stat(actual)).isFile()) throw new Error("upload source must be a regular file");
+    return actual;
+  }
+  const parent = await realpath(dirname(path));
+  if (!roots.some((root) => inside(root, parent))) throw new Error("download destination is outside the workspace and staging directory");
+  const out = join(parent, basename(path));
+  try {
+    await lstat(out);
+    throw new Error(`download destination already exists: ${out}`);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+  }
+  return out;
+}
+
+function receiptText(value: TransferReceipt): string {
+  const location = value.out ?? value.fileNames?.join(", ") ?? "";
+  return `[session ${value.session}] ${value.status} ${location}`.trim() +
+    (value.message === undefined ? "" : `: ${value.message}`);
+}
+
+/** Register three private actions in the same BrowserSkill instance. */
+export function registerFileTools(
+  deps: ToolDeps,
+  register: (definition: ToolDefinition) => void,
+  helpers: FileToolHelpers,
+): void {
+  const receipts = new Map<string, StoredReceipt>();
+  const active = new Set<string>();
+  const directory = join(
+    deps.config.sessionStateDirectory ?? defaultStartJournalDirectory(deps.config.bskPath),
+    "file-receipts",
+  );
+  const output = {
+    schema: RESULT_SCHEMA,
+    render: (_args: never, value: TransferReceipt) => [{ type: "text" as const, text: receiptText(value) }],
+  };
+  const keyFor = (session: string, requestId: string) => `${session}\0${requestId}`;
+  const pathFor = (key: string) => join(directory, `${createHash("sha256").update(key).digest("hex")}.json`);
+  const load = async (key: string): Promise<StoredReceipt | undefined> => {
+    try {
+      return JSON.parse(await readFile(pathFor(key), "utf8")) as StoredReceipt;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+      throw error;
+    }
+  };
+  const save = async (key: string, stored: StoredReceipt, create = false): Promise<void> => {
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const temp = join(directory, `${randomUUID()}.tmp`);
+    try {
+      await writeFile(temp, JSON.stringify(stored), { flag: "wx", mode: 0o600 });
+      if (create) await link(temp, pathFor(key));
+      else await rename(temp, pathFor(key));
+    } finally {
+      await rm(temp, { force: true });
+    }
+  };
+  const refresh = async (key: string, stored: StoredReceipt): Promise<TransferReceipt> => {
+    if ((stored.value.status === "pending" || stored.value.status === "unknown") && stored.action === "download" && stored.value.out !== undefined) {
+      try {
+        const file = await stat(stored.value.out);
+        if (file.isFile()) {
+          stored.value = { ...stored.value, status: "downloaded", byteSize: file.size };
+          await save(key, stored);
+        }
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      }
+    }
+    return stored.value.status === "pending" && !active.has(key)
+      ? { ...stored.value, status: "unknown", message: "original process ended before the transfer was confirmed" }
+      : stored.value;
+  };
+  const existingOrNew = async (session: string, requestId: string, action: "download" | "upload", fingerprint: string) => {
+    const key = keyFor(session, requestId);
+    const old = receipts.get(key);
+    if (old !== undefined) {
+      if (old.fingerprint !== fingerprint) throw new Error("requestId already names a different file operation");
+      return { key, stored: old, repeated: true };
+    }
+    const stored: StoredReceipt = { action, fingerprint, value: { session, requestId, status: "pending" } };
+    receipts.set(key, stored);
+    const previous = await load(key);
+    if (previous !== undefined) {
+      if (previous.fingerprint !== fingerprint) throw new Error("requestId already names a different file operation");
+      receipts.set(key, previous);
+      return { key, stored: previous, repeated: true };
+    }
+    try {
+      await save(key, stored, true);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+      const previous = (await load(key))!;
+      if (previous.fingerprint !== fingerprint) throw new Error("requestId already names a different file operation");
+      receipts.set(key, previous);
+      return { key, stored: previous, repeated: true };
+    }
+    return { key, stored, repeated: false };
+  };
+
+  register(defineTool({
+    name: "files.download",
+    description: "Capture a download from an owned Agent Window target before clicking and atomically write one new local file.",
+    parameters: {
+      session: SESSION_PARAM,
+      tabId: TAB_ID_PARAM,
+      requestId: { type: "string", required: true },
+      target: { type: "string", required: true },
+      out: { type: "string", required: true },
+      timeoutMs: TIMEOUT_MS_PARAM,
+    },
+    output,
+    async execute(args, exec) {
+      verifyRequestId(args.requestId);
+      if (args.target.trim() === "") throw new Error("target must be non-empty");
+      if (args.timeoutMs !== undefined && (args.timeoutMs <= 0 || args.timeoutMs > 0xffffffff)) throw new Error("timeoutMs must be 1..4294967295");
+      const session = deps.registry.resolve(args.session, "browser_files(action=download)");
+      const { key, stored, repeated } = await existingOrNew(session, args.requestId, "download", JSON.stringify({ action: "download", target: args.target, out: args.out, tabId: args.tabId, timeoutMs: args.timeoutMs }));
+      if (repeated) return refresh(key, stored);
+      active.add(key);
+      let dispatched = false;
+      try {
+        const out = await transferPath(deps, exec, args.out, "download");
+        stored.value = { ...stored.value, out };
+        await save(key, stored);
+        const command = ["download", args.target, "--session", session, "--out", out];
+        if (args.tabId !== undefined) command.push("--tab-id", String(args.tabId));
+        if (args.timeoutMs !== undefined) command.push("--timeout", `${args.timeoutMs}ms`);
+        const reply = await deps.queue.run(BROWSER_DOWNLOAD_QUEUE, () => {
+          dispatched = true;
+          return helpers.run(exec, command, "download", session);
+        }, exec.signal) as { tab_id: number; path: string; byte_size?: number };
+        if (resolve(reply.path) !== out) throw new Error("bsk returned a different download path");
+        const file = await stat(out);
+        if (!file.isFile()) throw new Error("bsk download output is not a regular file");
+        stored.value = { ...stored.value, status: "downloaded", tabId: reply.tab_id, byteSize: file.size };
+        await save(key, stored);
+      } catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        // The CLI commits atomically; a present file proves success even if its JSON reply was lost.
+        if (dispatched && stored.value.out !== undefined) {
+          try {
+            const file = await stat(stored.value.out);
+            if (file.isFile()) {
+              stored.value = { ...stored.value, status: "downloaded", byteSize: file.size };
+              await save(key, stored);
+              return stored.value;
+            }
+          } catch (readError) {
+            if ((readError as NodeJS.ErrnoException).code !== "ENOENT") throw readError;
+          }
+        }
+        stored.value = { ...stored.value, status: dispatched ? "unknown" : "failed", message };
+        await save(key, stored);
+      } finally {
+        active.delete(key);
+      }
+      return stored.value;
+    },
+    presentCall: (args) => ({ card: "terminal", title: helpers.commandLine(["download", args.target, "--out", args.out]), description: "Capture browser download" }),
+    presentResult: helpers.presentTerminalResult,
+  }));
+
+  register(defineTool({
+    name: "files.upload",
+    description: "Stage approved local files and attach them to an owned Agent Window target; this does not submit or save a form.",
+    parameters: {
+      session: SESSION_PARAM,
+      tabId: TAB_ID_PARAM,
+      requestId: { type: "string", required: true },
+      target: { type: "string", required: true },
+      files: { type: "array", items: { type: "string" }, required: true },
+      mode: { type: "string", enum: ["input", "drop"] },
+      timeoutMs: TIMEOUT_MS_PARAM,
+    },
+    output,
+    async execute(args, exec) {
+      verifyRequestId(args.requestId);
+      if (args.target.trim() === "") throw new Error("target must be non-empty");
+      if (args.files.length < 1 || args.files.length > 20) throw new Error("upload requires 1..20 files");
+      if (args.timeoutMs !== undefined && (args.timeoutMs <= 0 || args.timeoutMs > 0xffffffff)) throw new Error("timeoutMs must be 1..4294967295");
+      const session = deps.registry.resolve(args.session, "browser_files(action=upload)");
+      const { key, stored, repeated } = await existingOrNew(session, args.requestId, "upload", JSON.stringify({ action: "upload", target: args.target, files: args.files, tabId: args.tabId, mode: args.mode, timeoutMs: args.timeoutMs }));
+      if (repeated) return refresh(key, stored);
+      active.add(key);
+      let dispatched = false;
+      try {
+        const paths = await Promise.all(args.files.map((path) => transferPath(deps, exec, path, "upload")));
+        const command = ["upload", args.target, "--session", session];
+        for (const path of paths) command.push("--file", path);
+        if (args.tabId !== undefined) command.push("--tab-id", String(args.tabId));
+        if (args.mode !== undefined) command.push("--mode", args.mode);
+        if (args.timeoutMs !== undefined) command.push("--timeout", `${args.timeoutMs}ms`);
+        dispatched = true;
+        const reply = await helpers.run(exec, command, "upload", session) as { tab_id: number; file_names: string[] };
+        stored.value = { ...stored.value, status: "attached", tabId: reply.tab_id, fileNames: reply.file_names };
+        await save(key, stored);
+      } catch (error) {
+        stored.value = {
+          ...stored.value,
+          status: dispatched ? "unknown" : "failed",
+          message: error instanceof Error ? error.message : String(error),
+        };
+        await save(key, stored);
+      } finally {
+        active.delete(key);
+      }
+      return stored.value;
+    },
+    presentCall: (args) => ({ card: "terminal", title: helpers.commandLine(["upload", args.target]), description: "Attach local files in browser" }),
+    presentResult: helpers.presentTerminalResult,
+  }));
+
+  register(defineTool({
+    name: "files.status",
+    description: "Read the last known result for a file requestId without starting another browser action.",
+    parameters: { session: SESSION_PARAM, requestId: { type: "string", required: true } },
+    output,
+    isConcurrencySafe: () => true,
+    async execute(args) {
+      verifyRequestId(args.requestId);
+      const session = deps.registry.resolve(args.session, "browser_files(action=status)");
+      const key = keyFor(session, args.requestId);
+      const stored = receipts.get(key) ?? await load(key);
+      return stored === undefined ? {
+        session, requestId: args.requestId, status: "unknown" as const,
+        message: "no record in this plugin instance; inspect the original destination before any new action",
+      } : refresh(key, stored);
+    },
+    presentCall: (args) => ({ card: "terminal", title: `browser file request ${args.requestId}`, description: "Read file transfer status" }),
+    presentResult: helpers.presentTerminalResult,
+  }));
+}
