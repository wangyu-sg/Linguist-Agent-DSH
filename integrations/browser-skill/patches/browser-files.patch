+import { mkdtempSync, mkdirSync, realpathSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ToolDefinition, ToolRunContext } from "@deepseek-ai/dsh-tools";
+import { afterEach, expect, it } from "vitest";
+import { registerBrowserTools } from "../src/browser-tools";
+import { KeyedExecutor } from "../src/queue";
+import type { BskRunResult } from "../src/runner";
+import { SessionRegistry } from "../src/sessions";
+import type { PluginConfig } from "../src/tools";
+
+const created: string[] = [];
+afterEach(() => {
+  for (const path of created.splice(0)) rmSync(path, { recursive: true, force: true });
+});
+
+function fixture(reply: (args: string[]) => Promise<BskRunResult> | BskRunResult, existingWorkspace?: string) {
+  const workspace = existingWorkspace ?? mkdtempSync(join(tmpdir(), "la-dsh-bsk-files-"));
+  if (existingWorkspace === undefined) created.push(workspace);
+  const staging = join(workspace, "staging");
+  if (existingWorkspace === undefined) mkdirSync(staging);
+  const tools = new Map<string, ToolDefinition>();
+  const calls: string[][] = [];
+  const ctx = {
+    tools: { register: (tool: ToolDefinition) => tools.set(tool.name, tool) },
+    get: (name: string) => name === "sessions" ? { get: () => ({ header: { cwd: workspace } }) } : undefined,
+  };
+  const registry = new SessionRegistry(3);
+  for (const sessionId of ["s1", "s2"]) {
+    registry.trackStart({ sessionId, browserInstanceId: "chrome-1", startedAtMs: 0 });
+    registry.activate(sessionId);
+  }
+  const runner = {
+    async run(args: string[]) { calls.push(args); return reply(args); },
+    killAll() {}, killFor: () => 0,
+  };
+  const config: PluginConfig = {
+    bskPath: "bsk", fileStagingDirectory: staging, sessionStateDirectory: join(workspace, "bsk-journal"),
+    defaultTimeoutMs: 120_000,
+    maxSessions: 3, observationEnabled: false, thumbnailIntervalMs: 1500,
+    idleIntervalMs: 8000, lazyTools: false,
+  };
+  registerBrowserTools({
+    ctx: ctx as never, registry, runner, config, queue: new KeyedExecutor(),
+    observation: {
+      acquireForeground: () => () => {}, beginAction() {}, endAction() {},
+    } as never,
+  });
+  const tool = tools.get("browser_files")!;
+  const exec = { callId: "file-call", name: "browser_files", agent: { id: "dsh-session" }, signal: new AbortController().signal } as ToolRunContext;
+  const call = (args: Record<string, unknown>) => tool.execute(args as never, exec) as Promise<Record<string, unknown>>;
+  return { workspace, staging, calls, call };
+}
+
+it("downloads atomically once, reports conflicts, and attaches only approved local files", async () => {
+  const { workspace, staging, calls, call } = fixture((args) => {
+    if (args[0] === "download") {
+      const out = args[args.indexOf("--out") + 1];
+      writeFileSync(out, "synthetic export");
+      return { code: 0, stdout: JSON.stringify({ tab_id: 7, path: out }), stderr: "", timedOut: false, aborted: false };
+    }
+    return { code: 0, stdout: JSON.stringify({ tab_id: 7, file_names: ["upload.txt"] }), stderr: "", timedOut: false, aborted: false };
+  });
+  const download = { action: "download", session: "s1", requestId: "download-1", target: "#export", out: "export.txt" };
+  expect(await call(download)).toMatchObject({ status: "downloaded", out: join(realpathSync(workspace), "export.txt") });
+  expect(await call(download)).toMatchObject({ status: "downloaded" });
+  expect(await call({ action: "status", session: "s1", requestId: "download-1" })).toMatchObject({ status: "downloaded" });
+  expect(calls).toHaveLength(1);
+  expect(await call({ ...download, requestId: "download-2" })).toMatchObject({ status: "failed", message: expect.stringMatching(/already exists/) });
+  expect(calls).toHaveLength(1);
+
+  writeFileSync(join(staging, "upload.txt"), "synthetic input");
+  expect(await call({ action: "upload", session: "s1", requestId: "upload-1", target: "#file", files: [join(staging, "upload.txt")] }))
+    .toMatchObject({ status: "attached", fileNames: ["upload.txt"] });
+  expect(calls).toHaveLength(2);
+});
+
+it("rejects paths outside workspace/staging and never replays an uncertain transfer", async () => {
+  const outside = mkdtempSync(join(tmpdir(), "la-dsh-bsk-outside-"));
+  created.push(outside);
+  writeFileSync(join(outside, "outside.txt"), "synthetic outside");
+  const { calls, call } = fixture(() => ({ code: null, stdout: "", stderr: "", timedOut: false, aborted: true }));
+  expect(await call({ action: "upload", session: "s1", requestId: "outside-1", target: "#file", files: [join(outside, "outside.txt")] }))
+    .toMatchObject({ status: "failed", message: expect.stringMatching(/outside/) });
+  expect(calls).toHaveLength(0);
+  const download = { action: "download", session: "s1", requestId: "unknown-1", target: "#export", out: "unknown.txt" };
+  expect(await call(download)).toMatchObject({ status: "unknown" });
+  expect(await call(download)).toMatchObject({ status: "unknown" });
+  expect(await call({ action: "status", session: "s1", requestId: "unknown-1" })).toMatchObject({ status: "unknown" });
+  expect(calls).toHaveLength(1);
+});
+
+it("recovers the original requestId after plugin restart without another click", async () => {
+  const cancelled = { code: null, stdout: "", stderr: "", timedOut: false, aborted: true };
+  const first = fixture(() => cancelled);
+  const download = { action: "download", session: "s1", requestId: "restart-1", target: "#export", out: "restart.txt" };
+  expect(await first.call(download)).toMatchObject({ status: "unknown" });
+  const reopened = fixture(() => { throw new Error("should not execute again"); }, first.workspace);
+  expect(await reopened.call({ action: "status", session: "s1", requestId: "restart-1" })).toMatchObject({ status: "unknown" });
+  expect(await reopened.call(download)).toMatchObject({ status: "unknown" });
+  expect(reopened.calls).toHaveLength(0);
+});
